# Copy to .env (never commit .env). PowerShell: Copy-Item .env.example .env
# --- LLM (leave the key empty to run the agent in offline/deterministic mode)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# --- MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=a3-training
REGISTERED_MODEL=a3-classifier
# --- Airflow 3 (docker compose creates this user)
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_JWT_SECRET=replace-with-any-long-random-string
AIRFLOW_UID=50000
APPROVED_DAGS=ml_training_pipeline
# --- Kubernetes
K8S_NAMESPACE=mlops-a3
K8S_APP_LABEL=app=inference-api
K8S_CONTEXT=docker-desktop
# --- Agent
TOOL_TIMEOUT_SECONDS=30
MLFLOW_DISABLE_TELEMETRY=true
RETRAIN_MAX_MODEL_AGE_DAYS=30
